{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS Debug (Direct)",
      "args": ["${workspaceFolder}/src/main.ts"],
      "runtimeArgs": ["-r", "ts-node/register", "-r", "tsconfig-paths/register"],
      "sourceMaps": true,
      "protocol": "inspector",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "NestJS Attach (start:debug)",
      "port": 9229,
      "restart": true,
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Express (ts-node)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-r", "ts-node/register"],
      "args": ["${workspaceFolder}/src/server.ts"],
      "console": "integratedTerminal"
    }
  ]
}
